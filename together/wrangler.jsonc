{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "lilt-together",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "RoomDurable" }]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RoomDurable"]
    }
  ],
  // 自定义域名；若 bdprk.com 不在当前 Cloudflare 账号，删掉这段改用
  // lilt-together.<account>.workers.dev。
  "routes": [{ "pattern": "together.bdprk.com", "custom_domain": true }],
  "observability": { "enabled": true }
}